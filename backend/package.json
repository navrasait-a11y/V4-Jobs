{
  "name": "freejobwala-backend",
  "version": "1.0.0",
  "description": "Freejobwala - Job portal & recruitment marketplace backend (REST + Socket.IO) for web and mobile apps",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "seed": "node scripts/seed.js",
    "seed:admin": "node scripts/create-admin.js",
    "demo:seed": "node scripts/demo-data.js seed",
    "demo:remove": "node scripts/demo-data.js remove",
    "lint": "eslint src scripts",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\"",
    "test": "node --test --test-concurrency=1 tests/e2e.test.mjs tests/providers.test.mjs tests/redis-outage.test.mjs tests/storage-r2.test.mjs tests/demo-remove.test.mjs tests/invoice.test.mjs tests/assistant.test.mjs",
    "routes": "node scripts/list-routes.mjs",
    "seed:pages": "node scripts/seed-pages.js",
    "r2:check": "node scripts/check-r2.js",
    "r2:migrate": "node scripts/migrate-uploads-r2.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.16",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.3.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "otplib": "^13.5.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "razorpay": "^2.9.8",
    "sanitize-html": "^2.18.1",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
