# Backend API base (include /api/v1)
VITE_API_URL=http://localhost:5000/api/v1
# Socket.IO origin. Defaults to the API origin
VITE_SOCKET_URL=
# Google Identity Services web client id (same value must be in backend GOOGLE_CLIENT_IDS)
VITE_GOOGLE_CLIENT_ID=

# Browser push (Firebase web app: Project settings > General > Your apps, and Cloud Messaging > Web Push certificates)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Error monitoring (optional, Sentry browser DSN). Empty keeps it off
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
